{
  "version": 2,
  "builds": [
    {
      "src": "aplicacionWZC/madres-digitales-backend/api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "aplicacionWZC/madres-digitales-backend/api/index.js"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "functions": {
    "aplicacionWZC/madres-digitales-backend/api/index.js": {
      "maxDuration": 30
    }
  }
}

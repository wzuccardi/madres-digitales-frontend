{
  "version": 2,
  "buildCommand": "echo 'Omitiendo build - usando JavaScript precompilado'",
  "outputDirectory": ".",
  "functions": {
    "api/index.js": {
      "runtime": "@vercel/node@3",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "installCommand": "npm install --no-audit --no-fund --prefer-offline",
  "framework": null,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "PRISMA_GENERATE_SKIP": "true"
  }
}
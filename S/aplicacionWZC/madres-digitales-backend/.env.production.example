# Configuración de Producción - Madres Digitales Backend
# Copia este archivo y configura las variables en Vercel Dashboard

# Base de Datos PostgreSQL
DATABASE_URL=postgresql://usuario:password@host:5432/database?schema=public&connection_limit=5&pool_timeout=10

# JWT Configuration
JWT_SECRET=genera_un_secreto_seguro_aqui_64_caracteres_minimo
JWT_EXPIRES_IN=7d

# Server Configuration
PORT=3000
NODE_ENV=production

# CORS - Dominios permitidos (separados por coma)
ALLOWED_ORIGINS=https://tu-frontend.vercel.app,https://tu-dominio-custom.com

# WebSocket (si aplica)
WEBSOCKET_PORT=3001

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# Session
SESSION_SECRET=otro_secreto_seguro_para_sesiones

# Email (si aplica)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASS=tu-password-de-aplicacion

# Storage (si aplica)
STORAGE_BUCKET=tu-bucket-s3
AWS_ACCESS_KEY_ID=tu-access-key
AWS_SECRET_ACCESS_KEY=tu-secret-key
AWS_REGION=us-east-1

# Monitoring (opcional)
SENTRY_DSN=tu-sentry-dsn

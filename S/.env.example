# ========================================
# Variables de Entorno - Ejemplo
# Madres Digitales
# ========================================

# Versión del build
BUILD_VERSION=1.0.0

# Configuración de Dominio
DOMAIN=tudominio.com
CORS_ORIGIN=https://tudominio.com,https://www.tudominio.com

# Base de Datos PostgreSQL
POSTGRES_DB=madres_digitales_prod
POSTGRES_USER=madres_user
POSTGRES_PASSWORD=GENERAR_CONTRASEÑA_SEGURA_AQUI

# Redis
REDIS_PASSWORD=GENERAR_CONTRASEÑA_SEGURA_AQUI

# JWT Secrets
JWT_SECRET=GENERAR_JWT_SECRET_AQUI
JWT_REFRESH_SECRET=GENERAR_JWT_REFRESH_SECRET_AQUI

# Grafana
GRAFANA_PASSWORD=GENERAR_CONTRASEÑA_SEGURA_AQUI

# DigitalOcean Spaces
DO_SPACES_KEY=TU_SPACES_KEY
DO_SPACES_SECRET=TU_SPACES_SECRET
DO_SPACES_BUCKET=madres-digitales-backups
DO_SPACES_REGION=nyc3

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tuemail@tudominio.com
SMTP_PASSWORD=TU_APP_PASSWORD

# SSL Configuration
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Backup Configuration
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# Security
ENCRYPTION_KEY=GENERAR_CLAVE_DE_ENCRIPTACIÓN_AQUÍ
SESSION_SECRET=GENERAR_SESSION_SECRET_AQUÍ